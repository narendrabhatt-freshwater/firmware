# Save a report only after a successful link and binary conversion. Region sizes
# come from the linker map; ALLOC/LOAD sections account for RAM and flash copies.
cmake_minimum_required(VERSION 3.22)

foreach(input ELF MAP BINARY OBJDUMP BAUD COMPILER OUTPUT)
    if(NOT DEFINED ${input} OR "${${input}}" STREQUAL "")
        message(FATAL_ERROR "Firmware report requires ${input}")
    endif()
endforeach()

file(READ "${MAP}" map_text)
string(REPLACE "\n" ";" map_lines "${map_text}")
set(regions)
set(in_memory FALSE)
foreach(line IN LISTS map_lines)
    if(line STREQUAL "Memory Configuration")
        set(in_memory TRUE)
    elseif(in_memory AND line MATCHES "^\\*default\\*")
        break()
    elseif(in_memory AND line MATCHES "^([A-Za-z0-9_]+)[ \t]+(0x[0-9a-fA-F]+)[ \t]+(0x[0-9a-fA-F]+)")
        set(region "${CMAKE_MATCH_1}")
        set(address_${region} "${CMAKE_MATCH_2}")
        list(APPEND regions "${region}")
        math(EXPR origin_${region} "${CMAKE_MATCH_2}")
        math(EXPR capacity_${region} "${CMAKE_MATCH_3}")
        set(high_${region} "${origin_${region}}")
    endif()
endforeach()
if(NOT regions)
    message(FATAL_ERROR "No memory regions found in ${MAP}")
endif()

execute_process(COMMAND "${OBJDUMP}" -h "${ELF}"
    OUTPUT_VARIABLE section_text COMMAND_ERROR_IS_FATAL ANY)
string(REPLACE "\n" ";" section_lines "${section_text}")
set(sections)
set(section "")
foreach(line IN LISTS section_lines)
    if(line MATCHES "^[ \t]*[0-9]+[ \t]+([^ \t]+)[ \t]+([0-9a-fA-F]+)[ \t]+([0-9a-fA-F]+)[ \t]+([0-9a-fA-F]+)")
        set(section "${CMAKE_MATCH_1}")
        math(EXPR bytes "0x${CMAKE_MATCH_2}")
        math(EXPR vma "0x${CMAKE_MATCH_3}")
        math(EXPR lma "0x${CMAKE_MATCH_4}")
        set(address "0x${CMAKE_MATCH_3}")
    elseif(NOT section STREQUAL "" AND line MATCHES "ALLOC")
        if(bytes GREATER 0)
            list(APPEND sections "${section}|${address}|${bytes}")
            set(addresses "${vma}")
            if(line MATCHES "(^|[, ])LOAD([, ]|$)" AND NOT lma EQUAL vma)
                list(APPEND addresses "${lma}")
            endif()
            foreach(start IN LISTS addresses)
                math(EXPR end "${start} + ${bytes}")
                foreach(region IN LISTS regions)
                    math(EXPR limit "${origin_${region}} + ${capacity_${region}}")
                    if(start GREATER_EQUAL origin_${region} AND start LESS limit)
                        if(end GREATER high_${region})
                            set(high_${region} "${end}")
                        endif()
                        break()
                    endif()
                endforeach()
            endforeach()
        endif()
        set(section "")
    endif()
endforeach()
if(NOT sections)
    message(FATAL_ERROR "No allocated ELF sections found in ${ELF}")
endif()

function(pad value width output)
    string(LENGTH "${value}" length)
    math(EXPR count "${width} - ${length}")
    if(count LESS 1)
        set(count 1)
    endif()
    string(REPEAT " " ${count} spaces)
    set(${output} "${value}${spaces}" PARENT_SCOPE)
endfunction()

file(SIZE "${BINARY}" binary_bytes)
file(SHA256 "${BINARY}" checksum)
file(TIMESTAMP "${ELF}" built "%Y-%m-%d %H:%M:%S UTC" UTC)
set(report "\nChannel Card firmware\n")
string(APPEND report "  Binary:      bin/channel_MCU.bin (${binary_bytes} bytes)\n")
string(APPEND report "  Target:      STM32H725, Cortex-M7, Release\n")
string(APPEND report "  RS485:       ${BAUD} baud, 8N1\n")
string(APPEND report "  Toolchain:   ${COMPILER}\n")
string(APPEND report "  Built:       ${built}\n")
string(APPEND report "  SHA256:      ${checksum}\n\n")
string(APPEND report "Memory region  Origin      Used (B)    Capacity (B)  Free (B)    Used\n")
foreach(region IN LISTS regions)
    math(EXPR used "${high_${region}} - ${origin_${region}}")
    math(EXPR free "${capacity_${region}} - ${used}")
    math(EXPR percent "(10000 * ${used} + ${capacity_${region}} / 2) / ${capacity_${region}}")
    math(EXPR whole "${percent} / 100")
    math(EXPR fraction "${percent} % 100")
    if(fraction LESS 10)
        set(fraction "0${fraction}")
    endif()
    pad("${region}" 15 label)
    pad("${address_${region}}" 12 origin_column)
    pad("${used}" 12 used_column)
    pad("${capacity_${region}}" 14 capacity_column)
    pad("${free}" 12 free_column)
    string(APPEND report "${label}${origin_column}${used_column}${capacity_column}${free_column}${whole}.${fraction}%\n")
endforeach()
string(APPEND report "\nAllocated sections       Address     Bytes\n")
foreach(entry IN LISTS sections)
    string(REPLACE "|" ";" fields "${entry}")
    list(GET fields 0 name)
    list(GET fields 1 address)
    list(GET fields 2 bytes)
    pad("${name}" 25 label)
    string(APPEND report "${label}${address}  ${bytes}\n")
endforeach()
string(APPEND report "\nRAM figures include linker reservations and alignment, not runtime peaks.\n")
string(APPEND report "Initialized RAM also occupies flash; heap/stack reserve is shown above.\n")
file(WRITE "${OUTPUT}" "${report}")
