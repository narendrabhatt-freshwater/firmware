# ---- compiler and library selection ------------------------------------------

HOST_CXX               ?= c++
HOST_ARCH              := $(shell uname -m)
OBJDIR                  = object.$(HOST_ARCH)
BINDIR                  = bin
PKG_CONFIG             ?= pkg-config
MIDI_CFLAGS            := $(shell $(PKG_CONFIG) --cflags rtmidi)
MIDI_LIBS              := $(shell $(PKG_CONFIG) --libs rtmidi)

# ---- compiler and linker settings --------------------------------------------

STD                    ?= c++17
OPTIMIZATION           ?= -O2
DEBUG_FLAGS            ?= -g
WARNING_FLAGS          ?=

CPPFLAGS               += $(MIDI_CFLAGS)
CXXFLAGS               += -std=$(STD) $(OPTIMIZATION) $(DEBUG_FLAGS) $(WARNING_FLAGS) -MMD -MP
LDLIBS                 += $(MIDI_LIBS)

# ---- objects -----------------------------------------------------------------

OBJECTS                := $(OBJDIR)/voicebdtest_simulator.o \
                          $(OBJDIR)/voicebd_simulator.o
TARGET                  = $(BINDIR)/voicebdtest_simulator

# ---- makeable targets --------------------------------------------------------

.DEFAULT_GOAL          := all
.DELETE_ON_ERROR:
.PHONY                 : all clean

all                    : $(TARGET)

# ---- build rules -------------------------------------------------------------

$(OBJDIR)/%.o          : %.cpp makefile.simulator
	@mkdir -p "$(@D)"
	@$(HOST_CXX) $(CPPFLAGS) $(CXXFLAGS) -c "$<" -o "$@"

$(OBJDIR)/voicebd_simulator.o : ../channel-rewrite/voicebd.cpp makefile.simulator
	@mkdir -p "$(@D)"
	@$(HOST_CXX) $(CPPFLAGS) $(CXXFLAGS) -c "$<" -o "$@"

$(TARGET)              : $(OBJECTS)
	@mkdir -p "$(@D)"
	@printf 'Linking simulator MIDI test\n'
	@$(HOST_CXX) $(LDFLAGS) $^ -o "$@" $(LDLIBS)

# ---- cleanup -----------------------------------------------------------------

clean:
	@rm -f $(OBJECTS) $(OBJECTS:.o=.d) "$(TARGET)"

# ---- dependencies ------------------------------------------------------------

-include $(OBJECTS:.o=.d)
