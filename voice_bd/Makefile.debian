CXX = g++
PKG_CONFIG ?= pkg-config

PACKAGES = rtmidi libserialport alsa
CPPFLAGS += -I. $(shell $(PKG_CONFIG) --cflags $(PACKAGES))
CXXFLAGS ?= -std=c++20 -O3 -pthread
LDLIBS += $(shell $(PKG_CONFIG) --libs $(PACKAGES))

.PHONY: all clean
all: voicebd voicebdgui

voicebd: voicebd.cpp voicebdtest.cpp voicebd.h options.h Makefile.debian
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) voicebd.cpp voicebdtest.cpp $(LDFLAGS) $(LDLIBS) -o $@

clean:
	rm -f voicebd voicebdgui

voicebdgui: voicebd.cpp voicebdgui.cpp voicebd.h devices.h Makefile.debian
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) voicebd.cpp voicebdgui.cpp $(LDFLAGS) $(LDLIBS) -o $@
